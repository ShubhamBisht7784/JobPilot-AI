# Local Docker Compose database values only. Change before use.
POSTGRES_DB=jobpilot_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY

# Database connection for the backend
DB_URL=jdbc:postgresql://localhost:5432/jobpilot_db
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME_LOCAL_ONLY

# Application secrets: generate independent random Base64 32-byte values.
APP_JWT_SECRET=REPLACE_WITH_BASE64_32_BYTE_SECRET
APP_CRYPTO_ENCRYPTION_KEY=REPLACE_WITH_DIFFERENT_BASE64_32_BYTE_SECRET

# External integrations (optional until the relevant feature is used)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
APP_AI_ENABLED=true
# Gmail is optional. Set both values and activate the `gmail` Spring profile to enable it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# APP_CRYPTO_ENCRYPTION_KEY must be configured before connecting Gmail.
SERPAPI_API_KEY=
HUNTER_API_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:5173
JOB_DISCOVERY_ENABLED=true
JOB_DISCOVERY_FIXED_DELAY_MS=21600000
JOB_DISCOVERY_INITIAL_DELAY_MS=60000
JOB_DISCOVERY_QUERIES=Java Backend Developer fresher India,Spring Boot Developer entry level India
